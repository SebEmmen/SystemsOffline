[gd_scene format=3 uid="uid://bblku5gj5b1j"]

[sub_resource type="GDScript" id="GDScript_hojym"]
script/source = "extends CanvasLayer

@onready var hand: TextureRect = $HandWithKey

var shown_position: Vector2
var animation: Tween


func _ready() -> void:
	shown_position = hand.position
	hand.visible = false
	hand.mouse_filter = Control.MOUSE_FILTER_IGNORE


func show_hand() -> void:
	if animation and animation.is_running():
		animation.kill()

	hand.visible = true
	hand.position = shown_position + Vector2(0, 450)
	hand.modulate.a = 0.0

	animation = create_tween().set_parallel(true)

	animation.tween_property(
		hand, \"position\", shown_position, 0.4
	).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)

	animation.tween_property(
		hand, \"modulate:a\", 1.0, 0.3
	)

	await animation.finished


func hide_hand() -> void:
	if animation and animation.is_running():
		animation.kill()

	animation = create_tween().set_parallel(true)

	animation.tween_property(
		hand, \"position\", shown_position + Vector2(0, 450), 0.3
	).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)

	animation.tween_property(
		hand, \"modulate:a\", 0.0, 0.3
	)

	await animation.finished
	hand.visible = false
"

