[node name="ClueList" type="RichTextLabel" parent="MainPanel/MainLayout/SidePanel" unique_id=1786271436]
custom_minimum_size = Vector2(310, 340)
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.90588236, 0.95686275, 0.972549, 1)
theme_override_font_sizes/normal_font_size = 16
text = "1. Each zone (Lab, Garden, Aviary) contains at least one bird. The correct solution has one bird per row and column.

2. The Cardinal and the Eagle are both locked in a cage.

3. The Blue Jay is the only bird on a table.

4. The Albatross is the only bird asleep on a nest.

5. The Dove is on row 4.

6. In the Aviary, the Cardinal watches the Flamingo walk freely on the floor."

